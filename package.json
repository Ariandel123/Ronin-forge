{
  "name": "katana-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist",
    "db:create": "wrangler d1 create ronin-forge",
    "db:schema": "wrangler d1 execute ronin-forge --remote --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute ronin-forge --local --file=./schema.sql",
    "db:list": "wrangler d1 execute ronin-forge --remote --command \"SELECT id,name,email,katana,lang,created_at FROM commissions ORDER BY id DESC LIMIT 50\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.3",
    "vite": "^7.0.0",
    "wrangler": "^4.111.0"
  }
}
